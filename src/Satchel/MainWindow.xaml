<Window x:Class="Satchel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Satchel.ViewModels"
        xmlns:infra="clr-namespace:Satchel.Infrastructure"
        Title="Satchel" Width="1180" Height="760" MinWidth="920" MinHeight="560"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/satchel.ico">

    <Window.Resources>
        <infra:NotEmptyToVisibilityConverter x:Key="Vis" />
        <infra:NotEmptyToVisibilityConverter x:Key="InvVis" Invert="True" />
        <infra:EqualsToVisibilityConverter x:Key="EqVis" />
        <infra:EqualsToBoolConverter x:Key="EqBool" />

        <!-- Rounded thumbnail with a letter fallback underneath -->
        <DataTemplate x:Key="Thumb">
            <Grid Width="36" Height="36">
                <Border CornerRadius="8" Background="#262B37">
                    <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image infra:Thumbnails.Url="{Binding ThumbnailUrl}" Width="36" Height="36" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,36,36" RadiusX="8" RadiusY="8" />
                    </Image.Clip>
                </Image>
            </Grid>
        </DataTemplate>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="UpToDate">
                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NeedsKey">
                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Unavailable">
                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Local">
                    <Setter Property="Foreground" Value="{StaticResource Dim}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Ignored">
                    <Setter Property="Foreground" Value="{StaticResource Dim}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="AddonRow" DataType="{x:Type vm:AddonRowViewModel}">
            <Grid x:Name="RowRoot" Height="56" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Update" Command="{Binding UpdateCommand}" />
                        <MenuItem Header="Reinstall" Command="{Binding ReinstallCommand}" />
                        <Separator />
                        <MenuItem Header="Release channel" IsEnabled="{Binding IsManaged}">
                            <MenuItem Header="Stable" IsChecked="{Binding IsStable, Mode=OneWay}" Command="{Binding SetStableCommand}" />
                            <MenuItem Header="Beta" IsChecked="{Binding IsBeta, Mode=OneWay}" Command="{Binding SetBetaCommand}" />
                            <MenuItem Header="Alpha" IsChecked="{Binding IsAlpha, Mode=OneWay}" Command="{Binding SetAlphaCommand}" />
                        </MenuItem>
                        <MenuItem Header="Auto-update" IsChecked="{Binding AutoUpdate, Mode=OneWay}" Command="{Binding ToggleAutoUpdateCommand}" />
                        <MenuItem Header="Ignore updates" IsChecked="{Binding Ignored, Mode=OneWay}" Command="{Binding ToggleIgnoreCommand}" />
                        <Separator />
                        <MenuItem Header="Open website" Command="{Binding OpenWebsiteCommand}" />
                        <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}" />
                        <Separator />
                        <MenuItem Header="Remove…" Command="{Binding UninstallCommand}" Foreground="{StaticResource Danger}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>

                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Thumb}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="800">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Padding="6,0" Background="{StaticResource InfoSoft}"
                                Visibility="{Binding ChannelBadge, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding ChannelBadge}" FontSize="10.5" Foreground="{StaticResource Info}" />
                        </Border>
                        <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Dim}" Margin="8,1,0,0"
                                   ToolTip="Auto-update is on" Visibility="{Binding AutoUpdate, Converter={StaticResource Vis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding InstalledVersion}" FontSize="12.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstalledVersion}" />
                    <TextBlock FontSize="12" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               Visibility="{Binding ShowLatest, Converter={StaticResource Vis}}" ToolTip="{Binding LatestVersion}">
                        <Run Text="→ " /><Run Text="{Binding LatestVersion, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <Grid Grid.Column="3" VerticalAlignment="Center" ToolTip="{Binding StatusTooltip}">
                    <Button Style="{StaticResource PrimaryButton}" Content="Update" Padding="16,5" HorizontalAlignment="Left"
                            Command="{Binding UpdateCommand}" Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=UpdateAvailable}" />
                    <Button Padding="12,5" HorizontalAlignment="Left" Command="{Binding OpenWebsiteCommand}"
                            Foreground="{StaticResource Accent}" BorderBrush="#66F0B232"
                            Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=ManualUpdate}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Get update" />
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="11" Margin="7,1,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=Busy}" Margin="0,0,16,0">
                        <TextBlock Text="{Binding BusyText}" FontSize="12" Foreground="{StaticResource Muted}" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter='UpToDate,NeedsKey,Unavailable,Ignored,Local'}">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Success}" Margin="0,0,6,0"
                                   Visibility="{Binding State, Converter={StaticResource EqVis}, ConverterParameter=UpToDate}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" />
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Danger}" Margin="6,0,0,0"
                                   Visibility="{Binding Error, Converter={StaticResource Vis}}" />
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Column="4" Text="{Binding GameVersion}" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />

                <Border Grid.Column="5" Style="{StaticResource Pill}">
                    <TextBlock Text="{Binding ProviderName}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                </Border>

                <TextBlock Grid.Column="6" Text="{Binding ReleasedText}" ToolTip="{Binding ReleasedTooltip}" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />

                <Button Grid.Column="7" Style="{StaticResource IconButton}" Content="&#xE712;" ToolTip="More actions" AutomationProperties.Name="More actions"
                        Click="RowMenu_Click" Tag="{Binding ElementName=RowRoot}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SearchRow" DataType="{x:Type vm:SearchRowViewModel}">
            <Grid Height="68" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Thumb}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Author}" FontSize="12" Foreground="{StaticResource Dim}" Margin="8,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Summary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Latest}" FontSize="12.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Latest}" />
                    <TextBlock Text="{Binding Downloads}" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource Pill}">
                    <TextBlock Text="{Binding ProviderName}" FontSize="11.5" Foreground="{StaticResource Muted}" />
                </Border>
                <Grid Grid.Column="4" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Content="{Binding ButtonText}" Command="{Binding InstallCommand}" Padding="14,6" HorizontalAlignment="Stretch" ToolTip="{Binding ButtonTooltip}"
                            ToolTipService.ShowOnDisabled="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Surface2}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsManualOnly}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource Surface2}" />
                                        <Setter Property="BorderBrush" Value="#66F0B232" />
                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" VerticalAlignment="Bottom" Margin="4,0,4,-8" Height="3"
                                 Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <Style x:Key="PageGrid" TargetType="FrameworkElement">
            <Setter Property="Margin" Value="20,14,20,0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CheckForUpdatesCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{x:Static infra:WindowCommands.FocusFilter}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static infra:WindowCommands.FocusFilter}" Executed="FocusFilter_Executed" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/satchel.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Satchel" FontSize="16.5" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" AutomationProperties.Name="My addons"
                                 IsChecked="{Binding Page, Converter={StaticResource EqBool}, ConverterParameter=MyAddons}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="My addons" />
                            <Border Background="{StaticResource Accent}" CornerRadius="9" MinWidth="18" Height="18" Margin="8,0,0,0" Padding="5,0"
                                    Visibility="{Binding UpdateCount, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding UpdateCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" Content="Get addons"
                                 IsChecked="{Binding Page, Converter={StaticResource EqBool}, ConverterParameter=GetAddons}" />
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Nav" Content="Settings"
                                 IsChecked="{Binding Page, Converter={StaticResource EqBool}, ConverterParameter=Settings}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Game" Foreground="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Width="250" AutomationProperties.Name="Game install" ItemsSource="{Binding Installations}" SelectedItem="{Binding Selected}" ToolTip="{Binding Selected.Path}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Banner -->
        <Border Grid.Row="1" Margin="20,14,20,0" CornerRadius="8" Padding="14,10" BorderThickness="1"
                Visibility="{Binding HasBanner, Converter={StaticResource Vis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource InfoSoft}" />
                    <Setter Property="BorderBrush" Value="#335AA9E6" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BannerKind}" Value="Success">
                            <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                            <Setter Property="BorderBrush" Value="#334FBF7F" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BannerKind}" Value="Warning">
                            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                            <Setter Property="BorderBrush" Value="#44F0B232" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding BannerKind}" Value="Error">
                            <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                            <Setter Property="BorderBrush" Value="#44E5534B" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,1,10,0" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                            <Setter Property="Text" Value="&#xE946;" />
                            <Setter Property="Foreground" Value="{StaticResource Info}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BannerKind}" Value="Success">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BannerKind}" Value="Warning">
                                    <Setter Property="Text" Value="&#xE7BA;" />
                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BannerKind}" Value="Error">
                                    <Setter Property="Text" Value="&#xEA39;" />
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
                <Button Grid.Column="2" Content="{Binding BannerActionText}" Command="{Binding BannerActionCommand}" Margin="12,0,4,0" Padding="12,4"
                        VerticalAlignment="Center" Visibility="{Binding BannerActionText, Converter={StaticResource Vis}}" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="28" Height="28"
                        Command="{Binding DismissBannerCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Pages -->
        <Grid Grid.Row="2">

            <!-- My addons -->
            <Grid Style="{StaticResource PageGrid}" Visibility="{Binding Page, Converter={StaticResource EqVis}, ConverterParameter=MyAddons}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="380" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="FilterBox" AutomationProperties.Name="Filter addons" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=120}" Tag="Filter addons  (Ctrl+F)" Padding="32,7,9,7" />
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    </Grid>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" Content="Updates only" IsChecked="{Binding UpdatesOnly}" Margin="18,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenAddonsFolderCommand}" ToolTip="Open the AddOns folder" AutomationProperties.Name="Folder">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Folder" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding RescanCommand}" ToolTip="Re-read the AddOns folder and identify new addons" AutomationProperties.Name="Rescan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Rescan" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CheckForUpdatesCommand}" Margin="6,0,0,0" ToolTip="Check every source for new versions (F5)" AutomationProperties.Name="Check for updates">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Check for updates" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding UpdateAllCommand}" Margin="8,0,0,0" AutomationProperties.Name="Update all">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0" Foreground="{StaticResource OnAccent}" />
                                <TextBlock Text="{Binding UpdateAllText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Column headers -->
                <Border Grid.Row="1" Margin="0,16,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Content="ADDON" Command="{Binding SortCommand}" CommandParameter="name" Margin="4,0,0,0" />
                        <TextBlock Grid.Column="2" Text="VERSION" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}" />
                        <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Content="STATUS" Command="{Binding SortCommand}" CommandParameter="status" />
                        <Button Grid.Column="4" Style="{StaticResource HeaderButton}" Content="GAME" Command="{Binding SortCommand}" CommandParameter="game" />
                        <Button Grid.Column="5" Style="{StaticResource HeaderButton}" Content="SOURCE" Command="{Binding SortCommand}" CommandParameter="provider" />
                        <Button Grid.Column="6" Style="{StaticResource HeaderButton}" Content="UPDATED" Command="{Binding SortCommand}" CommandParameter="released" />
                    </Grid>
                </Border>

                <ListBox x:Name="AddonList" Grid.Row="2" Style="{StaticResource RowList}" ItemsSource="{Binding RowsView}" ItemTemplate="{StaticResource AddonRow}"
                         MouseDoubleClick="AddonList_MouseDoubleClick" />

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60"
                            Visibility="{Binding HasItems, ElementName=AddonList, Converter={StaticResource InvVis}}">
                    <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="36" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" />
                    <TextBlock Text="No addons here yet" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                    <TextBlock Text="Install some from Get addons, or clear the filter." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
                    <Button Content="Browse addons" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Center"
                            Command="{Binding NavigateCommand}" CommandParameter="GetAddons" />
                </StackPanel>
            </Grid>

            <!-- Get addons -->
            <Grid Style="{StaticResource PageGrid}" DataContext="{Binding Search}"
                  Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqVis}, ConverterParameter=GetAddons}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" AutomationProperties.Name="Search addons" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Tag="Search CurseForge, WoWInterface and Tukui…" Padding="32,8,9,8">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding ClearCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    </Grid>
                    <ComboBox Grid.Column="1" Width="160" Margin="10,0,0,0" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Search" Margin="10,0,0,0" Padding="20,7" Command="{Binding SearchCommand}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Tag="Or paste a link from CurseForge, WoWInterface, GitHub or Tukui" Padding="32,7,9,7">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding InstallFromUrlCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="&#xE71B;" Style="{StaticResource Icon}" Foreground="{StaticResource Dim}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    </Grid>
                    <Button Grid.Column="1" Content="Install from link" Margin="10,0,0,0" Command="{Binding InstallFromUrlCommand}" />
                    <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding InstallFromFileCommand}" AutomationProperties.Name="Install from file"
                            ToolTip="Install a .zip you downloaded yourself (you can also drop zips onto the window). Satchel identifies it and tracks updates.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="Install from file…" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="2" Margin="0,18,0,8">
                    <TextBlock Text="{Binding Heading}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Loading…" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Visibility="{Binding IsLoading, Converter={StaticResource Vis}}" />
                </Grid>

                <ListBox x:Name="ResultsList" Grid.Row="3" Style="{StaticResource RowList}" ItemsSource="{Binding Results}" ItemTemplate="{StaticResource SearchRow}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
                <TextBlock Grid.Row="3" Text="{Binding EmptyText}" Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60" MaxWidth="520"
                           Visibility="{Binding HasItems, ElementName=ResultsList, Converter={StaticResource InvVis}}" />
            </Grid>

            <!-- Settings -->
            <ScrollViewer DataContext="{Binding SettingsPage}" VerticalScrollBarVisibility="Auto" Padding="20,14,20,0"
                          Visibility="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource EqVis}, ConverterParameter=Settings}">
                <StackPanel MaxWidth="860" HorizontalAlignment="Left" Width="860">

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Addon sources" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="CurseForge API key" FontWeight="SemiBold" Margin="0,4,0,6" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10">
                                CurseForge requires every app to use its own key, and this is what keeps Satchel ad-free. Keys are free:
                                sign in at console.curseforge.com, create an API key, and paste it here. It's stored encrypted for your
                                Windows account and only ever sent to CurseForge.
                            </TextBlock>
                            <Grid Visibility="{Binding ShowCurseKeySaved, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource SuccessSoft}" BorderBrush="#554FBF7F" BorderThickness="1" CornerRadius="6" Padding="11,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Success}" Margin="0,0,9,0" />
                                        <TextBlock Text="Key saved" FontWeight="SemiBold" />
                                        <TextBlock Text="  ••••••••••••  stored encrypted, CurseForge is on" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="1" Content="Replace" Margin="10,0,0,0" Command="{Binding ReplaceCurseKeyCommand}" />
                                <Button Grid.Column="2" Content="Test" Margin="8,0,0,0" Command="{Binding TestCurseForgeKeyCommand}" />
                                <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Remove" Margin="4,0,0,0" Command="{Binding RemoveCurseForgeKeyCommand}" />
                            </Grid>
                            <Grid Visibility="{Binding ShowCurseKeyEditor, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="CurseKeyBox" AutomationProperties.Name="CurseForge API key" KeyDown="CurseKeyBox_KeyDown" />
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Save key" Margin="10,0,0,0" Click="SaveCurseKey_Click" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Cancel" Margin="4,0,0,0" Command="{Binding CancelCurseKeyCommand}"
                                        Visibility="{Binding HasCurseForgeKey, Converter={StaticResource Vis}}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding CurseKeyStatus}" Style="{StaticResource Hint}" Foreground="{StaticResource Text}" Margin="0,0,14,0"
                                           Visibility="{Binding CurseKeyStatus, Converter={StaticResource Vis}}" />
                                <TextBlock Text="Paste the key and press Enter." Style="{StaticResource Hint}" Margin="0,0,14,0"
                                           Visibility="{Binding ShowCurseKeyEditor, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource LinkButton}" Content="Get a free key at console.curseforge.com" Command="{Binding GetCurseForgeKeyCommand}" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18" />

                            <TextBlock Text="GitHub token (optional)" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="Only needed if you track lots of GitHub addons: it raises GitHub's limit from 60 to 5,000 requests an hour. A token with no scopes is enough." />
                            <Grid Visibility="{Binding ShowGitHubTokenSaved, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource SuccessSoft}" BorderBrush="#554FBF7F" BorderThickness="1" CornerRadius="6" Padding="11,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Success}" Margin="0,0,9,0" />
                                        <TextBlock Text="Token saved" FontWeight="SemiBold" />
                                        <TextBlock Text="  ••••••••••••  stored encrypted" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="1" Content="Replace" Margin="10,0,0,0" Command="{Binding ReplaceGitHubTokenCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Remove" Margin="4,0,0,0" Command="{Binding RemoveGitHubTokenCommand}" />
                            </Grid>
                            <Grid Visibility="{Binding ShowGitHubTokenEditor, Converter={StaticResource Vis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="GitHubTokenBox" AutomationProperties.Name="GitHub token" KeyDown="GitHubTokenBox_KeyDown" />
                                <Button Grid.Column="1" Content="Save token" Margin="10,0,0,0" Click="SaveGitHubToken_Click" />
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Cancel" Margin="4,0,0,0" Command="{Binding CancelGitHubTokenCommand}"
                                        Visibility="{Binding HasGitHubToken, Converter={StaticResource Vis}}" />
                            </Grid>
                            <TextBlock Text="{Binding GitHubStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Visibility="{Binding GitHubStatus, Converter={StaticResource Vis}}" />

                            <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0" Text="WoWInterface and Tukui (ElvUI) work without any key." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Game installations" Style="{StaticResource SectionTitle}" />
                            <ItemsControl ItemsSource="{Binding Installations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:InstallationRowViewModel}">
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding ClientName, Mode=OneWay}" />
                                                        <Run Text="{Binding AddonCount, Mode=OneWay, StringFormat='  ·  {0} addons'}" Foreground="{StaticResource Dim}" FontWeight="Normal" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=LostFocus}" Tag="Custom name" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding DataContext.Channels, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding DefaultChannel}" VerticalAlignment="Center" ToolTip="Release channel for newly installed addons" />
                                                <CheckBox Grid.Column="3" Style="{StaticResource Switch}" Content="Auto-update new" IsChecked="{Binding DefaultAutoUpdate}" Margin="14,0,8,0" VerticalAlignment="Center"
                                                          ToolTip="Newly installed addons in this game install update themselves" />
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Open AddOns folder" AutomationProperties.Name="Open AddOns folder" Command="{Binding OpenFolderCommand}" />
                                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Stop managing this install" AutomationProperties.Name="Stop managing this install" Command="{Binding RemoveCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Add game folder…" Command="{Binding AddInstallationCommand}" />
                                <Button Content="Find automatically" Margin="8,0,0,0" Command="{Binding DetectCommand}" />
                                <Button Content="Import from WowUp" Margin="8,0,0,0" Command="{Binding ImportWowUpCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Behavior" Style="{StaticResource SectionTitle}" />
                            <CheckBox Style="{StaticResource Switch}" Content="Check for updates when Satchel starts" IsChecked="{Binding CheckForUpdatesOnStartup}" Margin="0,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,10">
                                <TextBlock Text="Check in the background" VerticalAlignment="Center" Width="220" />
                                <ComboBox Width="170" ItemsSource="{Binding Intervals}" SelectedItem="{Binding SelectedInterval}" DisplayMemberPath="Label" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" Content="Keep running in the system tray when the window is closed" IsChecked="{Binding MinimizeToTray}" Margin="0,6" />
                            <CheckBox Style="{StaticResource Switch}" Content="Start with Windows (in the tray)" IsChecked="{Binding StartWithWindows}" Margin="0,6" />
                            <CheckBox Style="{StaticResource Switch}" Content="Install required dependencies automatically" IsChecked="{Binding InstallRequiredDependencies}" Margin="0,6" />
                            <CheckBox Style="{StaticResource Switch}" Content="Identify manually installed addons (CurseForge fingerprints)" IsChecked="{Binding IdentifyUnknownAddons}" Margin="0,6" />
                            <TextBlock Style="{StaticResource Hint}" Margin="48,0,0,0"
                                       Text="Per-addon options (auto-update, beta/alpha channel, ignore) are in each addon's ⋯ menu or right-click menu." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="Privacy" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Foreground="{StaticResource Text}"
                                       Text="Satchel shows no ads and sends no telemetry or analytics. It only talks to the addon sites you use (CurseForge, WoWInterface, GitHub, Tukui) and their download and image servers." />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock Text="{Binding Version}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
                                <Button Content="Open logs" Margin="8,0,0,0" Command="{Binding OpenLogsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                    <TextBlock Text="&#xE895;" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Spin">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Spin" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding BusyText}" FontSize="12" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
